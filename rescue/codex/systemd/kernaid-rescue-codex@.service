[Unit]
Description=KernAid experimental Rescue Codex one-request exec bridge
Requires=kernaid-rescue-codex.socket kernaid-rescue-vaultd.socket systemd-sysusers.service
BindsTo=kernaid-rescue-vaultd.service
After=kernaid-rescue-codex.socket kernaid-rescue-vaultd.socket kernaid-rescue-vaultd.service systemd-sysusers.service
CollectMode=inactive-or-failed
ConditionKernelCommandLine=boot=live
ConditionKernelCommandLine=kernaid.experimental_codex_exec=1
ConditionFileIsExecutable=/usr/lib/kernaid/kernaid-rescue-codex-executor
ConditionFileIsExecutable=/usr/lib/kernaid/codex

[Service]
Type=simple
ExecStart=/usr/lib/kernaid/kernaid-rescue-codex-executor
RuntimeDirectory=kernaid-rescue-codex-%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
RuntimeMaxSec=145s
TimeoutStartSec=5s
TimeoutStopSec=10s
Restart=no
StandardInput=socket
StandardOutput=null
StandardError=null
User=kernaid-codex
Group=kernaid-codex
SupplementaryGroups=kernaid-vault
UMask=0077
LimitCORE=0
LimitNOFILE=64
TasksMax=64
Delegate=pids
DelegateSubgroup=agent
KillMode=control-group
SendSIGKILL=yes
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
DevicePolicy=closed
InaccessiblePaths=-/etc/codex -/run/kernaid-rescue-openai-egress.sock
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
