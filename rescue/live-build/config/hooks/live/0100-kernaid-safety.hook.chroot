#!/bin/sh
set -eu
repair_candidate_marker=/usr/lib/kernaid/repair-candidate-image-v1
repair_candidate_binary=/usr/lib/kernaid/kernaid-rescue-repaird
repair_candidate_blockfd_probe=/usr/lib/kernaid/kernaid-blockfd-probe
repair_candidate_service=/etc/systemd/system/kernaid-rescue-repaird.service
repair_candidate_socket=/etc/systemd/system/kernaid-rescue-repaird.socket
repair_candidate_sysusers=/etc/sysusers.d/kernaid-repair-candidate.conf
repair_candidate_tmpfiles=/usr/lib/tmpfiles.d/kernaid-repair-candidate.conf
repair_candidate_ui_dropin=/etc/systemd/system/kernaid-ui.service.d/50-kernaid-repair-candidate.conf
repair_candidate_ready_dropin=/etc/systemd/system/kernaid-ready.service.d/50-kernaid-repair-candidate.conf
rescue_server=/usr/lib/kernaid/rescue_server.py
rescue_server_renderer=/usr/lib/kernaid/render_rescue_server.py
repair_target_handoff=/usr/lib/kernaid/repair_target_handoff.py
repair_write_socket=/etc/systemd/system/kernaid-rescue-target-write-capability.socket
repair_write_service=/etc/systemd/system/kernaid-rescue-target-write-capability@.service
repair_candidate_enabled=0

find /usr/lib/kernaid -xdev -type d -name __pycache__ -prune \
    -exec rm -rf -- {} +
find /usr/lib/kernaid -xdev -type f \( -name '*.pyc' -o -name '*.pyo' \) \
    -delete

chown root:root \
    /etc/systemd/coredump.conf.d \
    /etc/systemd/system \
    /etc/sysctl.d \
    /etc/sysusers.d \
    /usr/lib/kernaid \
    /usr/lib/tmpfiles.d
chmod 0755 \
    /etc/systemd/coredump.conf.d \
    /etc/systemd/system \
    /etc/sysctl.d \
    /etc/sysusers.d \
    /usr/lib/kernaid \
    /usr/lib/tmpfiles.d
chown root:root \
    /usr/lib/kernaid/offline_inspector.py \
    /usr/lib/kernaid/qemu_native_prompt_journal_probe.py \
    /usr/lib/kernaid/ready-check \
    /usr/lib/kernaid/rescue_application_relay.py \
    /usr/lib/kernaid/rescue_native_prompt_broker.py \
    "$repair_target_handoff" \
    "$rescue_server" \
    "$rescue_server_renderer" \
    /usr/lib/kernaid/rescue_ui_session_ready.py \
    /usr/lib/kernaid/secure_boot_state.py \
    /usr/lib/kernaid/matchbox-kbdconfig \
    /usr/lib/kernaid/tauri_network_probe.py \
    /usr/lib/kernaid/tauri_ui_ready_check.py
chmod 0644 \
    /usr/lib/kernaid/offline_inspector.py \
    /usr/lib/kernaid/qemu_native_prompt_journal_probe.py \
    /usr/lib/kernaid/ready-check \
    /usr/lib/kernaid/rescue_application_relay.py \
    /usr/lib/kernaid/rescue_native_prompt_broker.py \
    "$repair_target_handoff" \
    "$rescue_server" \
    "$rescue_server_renderer" \
    /usr/lib/kernaid/rescue_ui_session_ready.py \
    /usr/lib/kernaid/secure_boot_state.py \
    /usr/lib/kernaid/matchbox-kbdconfig \
    /usr/lib/kernaid/tauri_network_probe.py \
    /usr/lib/kernaid/tauri_ui_ready_check.py
chown root:root \
    /usr/lib/kernaid/codex \
    /usr/lib/kernaid/kernaid-rescue-codex \
    /usr/lib/kernaid/kernaid-rescue-codex-mounter \
    /usr/bin/kernaid-rescue-desk-shell \
    /usr/lib/kernaid/kernaid-rescue-openai-executor \
    /usr/lib/kernaid/kernaid-rescue-firstboot \
    /usr/lib/kernaid/kernaid-rescue-vaultd \
    /usr/bin/kernaid-codex-auth \
    /usr/bin/kernaid-rescue-vaultctl
chown root:root /usr/lib/kernaid/rescue-native-vault-unlock
chown root:root \
    /usr/lib/kernaid/rescue-ui-session \
    /usr/lib/kernaid/rescue-ui-session-wrapper
test -x /usr/lib/systemd/systemd-socket-proxyd
chmod 0755 \
    /usr/lib/kernaid/codex \
    /usr/lib/kernaid/kernaid-rescue-codex \
    /usr/lib/kernaid/kernaid-rescue-codex-mounter \
    /usr/bin/kernaid-rescue-desk-shell \
    /usr/lib/kernaid/kernaid-rescue-openai-executor \
    /usr/lib/kernaid/kernaid-rescue-firstboot \
    /usr/lib/kernaid/kernaid-rescue-vaultd \
    /usr/bin/kernaid-codex-auth \
    /usr/bin/kernaid-rescue-vaultctl
chmod 0755 /usr/lib/kernaid/rescue-native-vault-unlock
chmod 0755 \
    /usr/lib/kernaid/rescue-ui-session \
    /usr/lib/kernaid/rescue-ui-session-wrapper

if [ -e "$repair_candidate_marker" ] || [ -L "$repair_candidate_marker" ]; then
    for candidate_file in \
        "$repair_candidate_marker" \
        "$repair_candidate_binary" \
        "$repair_candidate_blockfd_probe" \
        "$repair_candidate_service" \
        "$repair_candidate_socket" \
        "$repair_candidate_sysusers" \
        "$repair_candidate_tmpfiles" \
        "$repair_candidate_ui_dropin" \
        "$repair_candidate_ready_dropin"; do
        test -f "$candidate_file"
        test ! -L "$candidate_file"
    done
    test -x "$repair_candidate_binary"
    test -x "$repair_candidate_blockfd_probe"
    grep -Fxq 'kernaid.repair=fstab-v1' "$repair_candidate_marker"
    chown root:root \
        "$repair_candidate_marker" \
        "$repair_candidate_binary" \
        "$repair_candidate_blockfd_probe" \
        "$repair_candidate_service" \
        "$repair_candidate_socket" \
        "$repair_candidate_sysusers" \
        "$repair_candidate_tmpfiles" \
        "$repair_candidate_ui_dropin" \
        "$repair_candidate_ready_dropin" \
        /etc/systemd/system/kernaid-ui.service.d \
        /etc/systemd/system/kernaid-ready.service.d
    chmod 0755 \
        "$repair_candidate_binary" \
        "$repair_candidate_blockfd_probe" \
        /etc/systemd/system/kernaid-ui.service.d \
        /etc/systemd/system/kernaid-ready.service.d
    chmod 0644 \
        "$repair_candidate_marker" \
        "$repair_candidate_service" \
        "$repair_candidate_socket" \
        "$repair_candidate_sysusers" \
        "$repair_candidate_tmpfiles" \
        "$repair_candidate_ui_dropin" \
        "$repair_candidate_ready_dropin"
    repair_candidate_enabled=1
else
    for candidate_file in \
        "$repair_candidate_binary" \
        "$repair_candidate_blockfd_probe" \
        "$repair_candidate_service" \
        "$repair_candidate_socket" \
        "$repair_candidate_sysusers" \
        "$repair_candidate_tmpfiles" \
        "$repair_candidate_ui_dropin" \
        "$repair_candidate_ready_dropin"; do
        test ! -e "$candidate_file"
        test ! -L "$candidate_file"
    done
fi

if [ "$repair_candidate_enabled" = "1" ]; then
    for write_capability_unit in "$repair_write_socket" "$repair_write_service"; do
        test -f "$write_capability_unit"
        test ! -L "$write_capability_unit"
        chown root:root "$write_capability_unit"
        chmod 0644 "$write_capability_unit"
    done
else
    rm -f -- "$repair_write_socket" "$repair_write_service"
    test ! -e "$repair_write_socket"
    test ! -e "$repair_write_service"
fi

test -f "$rescue_server"
test ! -L "$rescue_server"
test -f "$rescue_server_renderer"
test ! -L "$rescue_server_renderer"
rescue_server_mode=stable
if [ "$repair_candidate_enabled" = "1" ]; then
    rescue_server_mode=candidate
fi
rendered_rescue_server="$(mktemp /usr/lib/kernaid/.rescue_server.py.XXXXXX)"
trap 'rm -f -- "$rendered_rescue_server"' EXIT HUP INT TERM
python3 -I -B "$rescue_server_renderer" \
    --mode "$rescue_server_mode" \
    --input "$rescue_server" >"$rendered_rescue_server"
chown root:root "$rendered_rescue_server"
chmod 0644 "$rendered_rescue_server"
mv -f "$rendered_rescue_server" "$rescue_server"
rendered_rescue_server=
rendered_repair_target_handoff="$(mktemp /usr/lib/kernaid/.repair_target_handoff.py.XXXXXX)"
trap 'rm -f -- "$rendered_rescue_server" "$rendered_repair_target_handoff"' EXIT HUP INT TERM
python3 -I -B "$rescue_server_renderer" \
    --mode "$rescue_server_mode" \
    --expected-blocks 21 \
    --input "$repair_target_handoff" >"$rendered_repair_target_handoff"
chown root:root "$rendered_repair_target_handoff"
chmod 0644 "$rendered_repair_target_handoff"
mv -f "$rendered_repair_target_handoff" "$repair_target_handoff"
rendered_repair_target_handoff=
rm -f -- "$rescue_server_renderer"
python3 -I -B -c \
    'from pathlib import Path; p=Path("/usr/lib/kernaid/rescue_server.py"); compile(p.read_bytes(), str(p), "exec", dont_inherit=True)'
if [ "$repair_candidate_enabled" = "1" ]; then
    grep -Fq '/api/rescue/repair' "$rescue_server"
    grep -Fq 'kernaid.dev/rescue-repair-service/v1alpha1' "$rescue_server"
    grep -Fq 'repair.fstab.rollback.prepare' "$rescue_server"
    grep -Fq 'repair.crypttab.rollback.prepare' "$rescue_server"
else
    ! grep -Fq '/api/rescue/repair' "$rescue_server"
    ! grep -Fq 'kernaid.dev/rescue-repair-service/' "$rescue_server"
    ! grep -Fq 'repair.fstab.' "$rescue_server"
    ! grep -Fq 'repair.crypttab.' "$rescue_server"
fi
grep -Fq '/api/inventory' "$rescue_server"
grep -Fq '/api/rescue/inspect-installed-target' "$rescue_server"
grep -Fq '/api/authorize-observe' "$rescue_server"
grep -Fq '/api/rescue/provider/openai' "$rescue_server"
python3 -I -B -c \
    'from pathlib import Path; p=Path("/usr/lib/kernaid/repair_target_handoff.py"); compile(p.read_bytes(), str(p), "exec", dont_inherit=True)'
python3 -I -B -c \
    'from pathlib import Path; p=Path("/usr/lib/kernaid/rescue_native_prompt_broker.py"); compile(p.read_bytes(), str(p), "exec", dont_inherit=True)'
python3 -I -B -c \
    'from pathlib import Path; p=Path("/usr/lib/kernaid/qemu_native_prompt_journal_probe.py"); compile(p.read_bytes(), str(p), "exec", dont_inherit=True)'
grep -Fq 'target.readonly.acquire' "$repair_target_handoff"
grep -Fq 'target.recovery.readonly.acquire' "$repair_target_handoff"
if [ "$repair_candidate_enabled" = "1" ]; then
    grep -Fq 'target.pending.readwrite.acquire' "$repair_target_handoff"
    grep -Fq 'target.rollback.pending.readwrite.acquire' "$repair_target_handoff"
    grep -Fq '/run/kernaid-rescue-target-write-capability.sock' "$repair_target_handoff"
else
    ! grep -Fq 'target.pending.readwrite.acquire' "$repair_target_handoff"
    ! grep -Fq 'target.rollback.pending.readwrite.acquire' "$repair_target_handoff"
    ! grep -Fq '/run/kernaid-rescue-target-write-capability.sock' "$repair_target_handoff"
fi
if find /usr/lib/kernaid -xdev \
    \( -type d -name __pycache__ -o -type f \( -name '*.pyc' -o -name '*.pyo' \) \) \
    -print -quit | grep -q .; then
    echo "Python bytecode leaked into the Rescue payload" >&2
    exit 1
fi
trap - EXIT HUP INT TERM

# Pin the product theme into every generated initramfs. The explicit rebuild
# prevents Plymouth from falling back to distribution artwork at physical boot.
plymouth_theme_dir=/usr/share/plymouth/themes/kernaid
for branding_file in \
    /etc/issue \
    /etc/issue.net \
    /etc/plymouth/plymouthd.conf \
    "$plymouth_theme_dir/kernaid.plymouth" \
    "$plymouth_theme_dir/kernaid.script" \
    "$plymouth_theme_dir/kernaid-splash.png"; do
    test -f "$branding_file"
    test ! -L "$branding_file"
done
chown root:root /etc/plymouth "$plymouth_theme_dir"
chmod 0755 /etc/plymouth "$plymouth_theme_dir"
chown root:root \
    /etc/issue \
    /etc/issue.net \
    /etc/plymouth/plymouthd.conf \
    "$plymouth_theme_dir/kernaid.plymouth" \
    "$plymouth_theme_dir/kernaid.script" \
    "$plymouth_theme_dir/kernaid-splash.png"
chmod 0644 \
    /etc/issue \
    /etc/issue.net \
    /etc/plymouth/plymouthd.conf \
    "$plymouth_theme_dir/kernaid.plymouth" \
    "$plymouth_theme_dir/kernaid.script" \
    "$plymouth_theme_dir/kernaid-splash.png"
/usr/sbin/plymouth-set-default-theme kernaid
test "$(/usr/sbin/plymouth-set-default-theme)" = kernaid
/usr/sbin/update-initramfs -u -k all

chown root:root \
    /etc/lightdm/lightdm.conf.d/99-kernaid-rescue-ui.conf \
    /etc/pam.d/kernaid-rescue-ui-autologin \
    /etc/systemd/system/kernaid-offline-inspector-key.service \
    /etc/systemd/system/kernaid-offline-inspector.socket \
    /etc/systemd/system/kernaid-offline-inspector@.service \
    /etc/systemd/system/kernaid-provider-executor-status-probe.socket \
    /etc/systemd/system/kernaid-provider-executor-status-probe@.service \
    /etc/systemd/system/kernaid-provider-lease-kill-vaultd.socket \
    /etc/systemd/system/kernaid-provider-lease-kill-vaultd@.service \
    /etc/systemd/system/kernaid-provider-lease-probe.socket \
    /etc/systemd/system/kernaid-provider-lease-probe@.service \
    /etc/systemd/system/kernaid-qemu-native-prompt-journal-proof@.service \
    /etc/systemd/system/kernaid-rescue-openai-egress.service \
    /etc/systemd/system/kernaid-rescue-openai-egress.socket \
    /etc/systemd/system/kernaid-rescue-openai-executor.socket \
    /etc/systemd/system/kernaid-rescue-openai-executor@.service \
    /etc/systemd/system/kernaid-rescue-application.socket \
    /etc/systemd/system/kernaid-rescue-application.service \
    /etc/systemd/system/kernaid-rescue-codex.socket \
    /etc/systemd/system/kernaid-rescue-codex@.service \
    /etc/systemd/system/kernaid-rescue-codex-mounter.socket \
    /etc/systemd/system/kernaid-rescue-codex-mounter@.service \
    /etc/systemd/system/kernaid-rescue-desk-shell.service \
    /etc/systemd/system/kernaid-rescue-ui-session-ready.service \
    /etc/systemd/system/kernaid-rescue-firstboot.service \
    /etc/systemd/system/kernaid-rescue-native-prompt.service \
    /etc/systemd/system/kernaid-rescue-native-prompt.socket \
    /etc/systemd/system/kernaid-rescue-native-vault-unlock.service \
    /etc/systemd/system/kernaid-rescue-target-capability.socket \
    /etc/systemd/system/kernaid-rescue-target-capability@.service \
    /etc/systemd/system/kernaid-rescue-vaultd.service \
    /etc/systemd/system/kernaid-rescue-vaultd.socket \
    /etc/systemd/system/kernaid-ready.service \
    /etc/systemd/system/kernaid-tauri-network-probe-address.service \
    /etc/systemd/system/kernaid-tauri-network-probe-baseline.service \
    /etc/systemd/system/kernaid-tauri-network-probe.socket \
    /etc/systemd/system/kernaid-tauri-network-probe@.service \
    /etc/systemd/system/kernaid-ui.service \
    /etc/sysusers.d/kernaid.conf \
    /etc/sysctl.d/99-kernaid-rescue-core.conf \
    /etc/systemd/coredump.conf.d/99-kernaid-rescue.conf \
    /usr/share/xsessions/kernaid-rescue-ui.desktop \
    /usr/lib/tmpfiles.d/kernaid.conf
chmod 0644 \
    /etc/lightdm/lightdm.conf.d/99-kernaid-rescue-ui.conf \
    /etc/pam.d/kernaid-rescue-ui-autologin \
    /etc/systemd/system/kernaid-offline-inspector-key.service \
    /etc/systemd/system/kernaid-offline-inspector.socket \
    /etc/systemd/system/kernaid-offline-inspector@.service \
    /etc/systemd/system/kernaid-provider-executor-status-probe.socket \
    /etc/systemd/system/kernaid-provider-executor-status-probe@.service \
    /etc/systemd/system/kernaid-provider-lease-kill-vaultd.socket \
    /etc/systemd/system/kernaid-provider-lease-kill-vaultd@.service \
    /etc/systemd/system/kernaid-provider-lease-probe.socket \
    /etc/systemd/system/kernaid-provider-lease-probe@.service \
    /etc/systemd/system/kernaid-qemu-native-prompt-journal-proof@.service \
    /etc/systemd/system/kernaid-rescue-openai-egress.service \
    /etc/systemd/system/kernaid-rescue-openai-egress.socket \
    /etc/systemd/system/kernaid-rescue-openai-executor.socket \
    /etc/systemd/system/kernaid-rescue-openai-executor@.service \
    /etc/systemd/system/kernaid-rescue-application.socket \
    /etc/systemd/system/kernaid-rescue-application.service \
    /etc/systemd/system/kernaid-rescue-codex.socket \
    /etc/systemd/system/kernaid-rescue-codex@.service \
    /etc/systemd/system/kernaid-rescue-codex-mounter.socket \
    /etc/systemd/system/kernaid-rescue-codex-mounter@.service \
    /etc/systemd/system/kernaid-rescue-desk-shell.service \
    /etc/systemd/system/kernaid-rescue-ui-session-ready.service \
    /etc/systemd/system/kernaid-rescue-firstboot.service \
    /etc/systemd/system/kernaid-rescue-native-prompt.service \
    /etc/systemd/system/kernaid-rescue-native-prompt.socket \
    /etc/systemd/system/kernaid-rescue-native-vault-unlock.service \
    /etc/systemd/system/kernaid-rescue-target-capability.socket \
    /etc/systemd/system/kernaid-rescue-target-capability@.service \
    /etc/systemd/system/kernaid-rescue-vaultd.service \
    /etc/systemd/system/kernaid-rescue-vaultd.socket \
    /etc/systemd/system/kernaid-ready.service \
    /etc/systemd/system/kernaid-tauri-network-probe-address.service \
    /etc/systemd/system/kernaid-tauri-network-probe-baseline.service \
    /etc/systemd/system/kernaid-tauri-network-probe.socket \
    /etc/systemd/system/kernaid-tauri-network-probe@.service \
    /etc/systemd/system/kernaid-ui.service \
    /etc/sysusers.d/kernaid.conf \
    /etc/sysctl.d/99-kernaid-rescue-core.conf \
    /etc/systemd/coredump.conf.d/99-kernaid-rescue.conf \
    /usr/share/xsessions/kernaid-rescue-ui.desktop \
    /usr/lib/tmpfiles.d/kernaid.conf

# The live user must not receive subordinate-ID ranges. The companion and
# daemon also verify the initial user namespace, while removing set-ID bits
# from optional uidmap helpers keeps this image safe if dependencies change.
for key in SUB_UID_COUNT SUB_GID_COUNT; do
    sed -i "/^[[:space:]]*${key}[[:space:]]/d" /etc/login.defs
    printf '%s\t0\n' "$key" >> /etc/login.defs
done
for helper in /usr/bin/newuidmap /usr/bin/newgidmap; do
    if [ -e "$helper" ]; then
        chmod u-s,g-s "$helper"
    fi
done

systemctl enable kernaid-ready.service
systemctl enable kernaid-ui.service
systemctl enable kernaid-rescue-desk-shell.service
systemctl enable kernaid-offline-inspector.socket
systemctl enable kernaid-rescue-openai-egress.socket
systemctl enable kernaid-rescue-openai-executor.socket
systemctl enable kernaid-rescue-application.socket
systemctl enable kernaid-rescue-codex.socket
systemctl enable kernaid-rescue-codex-mounter.socket
systemctl enable kernaid-rescue-firstboot.service
systemctl enable kernaid-rescue-native-prompt.socket
systemctl enable kernaid-rescue-vaultd.socket
systemctl enable kernaid-rescue-vaultd.service
if [ "$repair_candidate_enabled" = "1" ]; then
    systemctl enable kernaid-rescue-repaird.socket
fi
systemctl mask swap.target
mkdir -p /etc/polkit-1/rules.d
cat > /etc/polkit-1/rules.d/49-kernaid-observe.rules <<'RULE'
polkit.addRule(function(action, subject) {
  if (subject.user == "kernaid-rescue-ui") {
    return polkit.Result.NO;
  }
  if (subject.user == "kernaid" && action.id.indexOf("org.freedesktop.udisks2.filesystem-mount") == 0) {
    return polkit.Result.NO;
  }
});
RULE
