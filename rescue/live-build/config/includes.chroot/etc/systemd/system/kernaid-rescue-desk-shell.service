[Unit]
Description=KernAid Rescue Tauri desktop shell
Requires=kernaid-ui.service live-config.service kernaid-rescue-ui-session-ready.service kernaid-offline-inspector.socket kernaid-rescue-application.socket kernaid-rescue-vaultd.socket kernaid-rescue-openai-executor.socket kernaid-rescue-openai-egress.socket kernaid-rescue-codex.socket kernaid-tauri-network-probe-baseline.service
After=kernaid-ui.service live-config.service kernaid-rescue-ui-session-ready.service display-manager.service kernaid-offline-inspector.socket kernaid-rescue-application.socket kernaid-rescue-vaultd.socket kernaid-rescue-openai-executor.socket kernaid-rescue-openai-egress.socket kernaid-rescue-codex.socket kernaid-tauri-network-probe-baseline.service
Wants=display-manager.service
Before=kernaid-ready.service
ConditionKernelCommandLine=boot=live
StartLimitIntervalSec=120s
StartLimitBurst=30

[Service]
Type=exec
ExecStart=/usr/bin/kernaid-rescue-desk-shell
Restart=always
RestartSec=1s
StandardOutput=journal+console
StandardError=journal+console
User=kernaid-rescue-ui
Group=kernaid-rescue-ui
Environment=HOME=/run/kernaid-rescue-desk-shell
Environment=USER=kernaid-rescue-ui
Environment=LOGNAME=kernaid-rescue-ui
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/lightdm/kernaid-rescue-ui/xauthority
Environment=XDG_RUNTIME_DIR=/run/kernaid-rescue-desk-shell
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/kernaid-rescue-desk-shell/no-session-bus
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/kernaid-rescue-desk-shell/no-system-bus
Environment=GDK_BACKEND=x11
Environment=NO_AT_BRIDGE=1
# WebKitGTK 2.52 must retain a valid shared-memory backing-store transport.
# WEBKIT_DISABLE_DMABUF_RENDERER is intentionally forbidden here.
Environment=WEBKIT_DISABLE_COMPOSITING_MODE=1
Environment=WEBKIT_DMABUF_RENDERER_FORCE_SHM=1
Environment=WEBKIT_DMABUF_RENDERER_DISABLE_GBM=1
Environment=WEBKIT_SKIA_ENABLE_CPU_RENDERING=1
Environment=LIBGL_ALWAYS_SOFTWARE=1
# The live UI is ephemeral; prevent llvmpipe from filling the attested runtime
# directory with an on-disk shader cache.
Environment=MESA_SHADER_CACHE_DISABLE=true
RuntimeDirectory=kernaid-rescue-desk-shell
RuntimeDirectoryMode=0700
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
PrivatePIDs=yes
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=yes
DevicePolicy=closed
PrivateTmp=yes
TemporaryFileSystem=/run:ro
BindPaths=/run/kernaid-rescue-desk-shell
BindReadOnlyPaths=/run/lightdm/kernaid-rescue-ui/xauthority -/run/kernaid-tauri-network-probe/baseline-v1
BindReadOnlyPaths=/tmp/.X11-unix/X0
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=graphical.target
