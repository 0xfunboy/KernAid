[Unit]
Description=KernAid Rescue Codex mount broker socket
Requires=systemd-sysusers.service
After=systemd-sysusers.service
Before=kernaid-rescue-vaultd.service
ConditionKernelCommandLine=boot=live

[Socket]
ListenSequentialPacket=/run/kernaid-rescue-codex-mounter.sock
Accept=yes
MaxConnections=1
Backlog=1
SocketMode=0600
SocketUser=root
SocketGroup=root
RemoveOnStop=yes
PassCredentials=no
PassSecurity=no
PassPacketInfo=no
Timestamping=off

[Install]
WantedBy=sockets.target
