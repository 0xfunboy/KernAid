[Unit]
Description=KernAid QEMU-only Tauri network probe listener
ConditionPathExists=/sys/firmware/qemu_fw_cfg/by_name/opt/kernaid-tauri-sandbox-probe/raw
Requires=kernaid-tauri-network-probe-address.service
After=kernaid-tauri-network-probe-address.service
Before=kernaid-tauri-network-probe-baseline.service kernaid-rescue-desk-shell.service

[Socket]
ListenStream=192.0.2.1:41917
Accept=yes
MaxConnections=4
Backlog=4
FreeBind=no
