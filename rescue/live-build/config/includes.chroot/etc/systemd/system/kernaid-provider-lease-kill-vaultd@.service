[Unit]
Description=KernAid QEMU-only provider lease vault-kill connection
Requires=kernaid-provider-lease-kill-vaultd.socket
BindsTo=kernaid-rescue-vaultd.service
After=kernaid-provider-lease-kill-vaultd.socket kernaid-rescue-vaultd.service
CollectMode=inactive-or-failed
ConditionKernelCommandLine=boot=live
ConditionCredential=provider-lease-probe
ConditionPathExists=/run/credentials/@system/provider-lease-probe
ConditionPathExists=/sys/firmware/qemu_fw_cfg/by_name/opt/io.systemd.credentials/provider-lease-probe/raw
ConditionPathExists=/run/kernaid-rescue-vault/provider-lease-probe-validated-v1
ConditionPathExists=/run/kernaid-rescue-vault/lifecycle-active-v1

[Service]
Type=oneshot
LoadCredential=provider-lease-probe
ExecCondition=/usr/bin/python3 -I -B -c 'import hashlib,pathlib,sys; data=pathlib.Path(sys.argv[1]).read_bytes(); sys.exit(not (len(data) == 15508 and hashlib.sha256(data).hexdigest() == "23470d54d04fd4d025988e9fabf7401b12c9157c6d58162295c01817c103a08f"))' ${CREDENTIALS_DIRECTORY}/provider-lease-probe
ExecStart=/usr/bin/systemctl --no-ask-password --no-pager kill --signal=KILL --kill-whom=main kernaid-rescue-vaultd.service
TimeoutStartSec=10s
TimeoutStopSec=5s
Restart=no
StandardInput=null
StandardOutput=null
StandardError=null
User=root
Group=root
SupplementaryGroups=
UMask=0077
LimitCORE=0
LimitNOFILE=16
TasksMax=1
KillMode=control-group
SendSIGKILL=yes
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
DevicePolicy=closed
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
