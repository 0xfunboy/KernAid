[Unit]
Description=KernAid Rescue readiness marker
After=multi-user.target kernaid-ui.service kernaid-rescue-openai-egress.socket kernaid-rescue-vaultd.service
Wants=kernaid-ui.service kernaid-rescue-openai-egress.socket kernaid-rescue-vaultd.service

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/kernaid/ready-check
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
