[Unit]
Description=KernAid Rescue readiness marker
After=multi-user.target kernaid-ui.service
Requires=kernaid-ui.service

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/kernaid/ready-check
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
