[Unit]
Description=KernAid dormant read-only target capability handoff
Requires=kernaid-rescue-target-capability.socket kernaid-offline-inspector-key.service systemd-sysusers.service
After=kernaid-rescue-target-capability.socket kernaid-offline-inspector-key.service systemd-sysusers.service
CollectMode=inactive-or-failed
ConditionKernelCommandLine=boot=live
ConditionPathExists=/run/kernaid-offline-inspector/target-id.key

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -B /usr/lib/kernaid/repair_target_handoff.py
Environment=KERNAID_TARGET_ID_KEY_FILE=/run/kernaid-offline-inspector/target-id.key
RuntimeMaxSec=12s
TimeoutStartSec=5s
TimeoutStopSec=2s
Restart=no
KillMode=control-group
SendSIGKILL=yes
StandardOutput=null
StandardError=null
User=root
Group=root
SupplementaryGroups=
UMask=0077
LimitCORE=0
LimitNOFILE=16
TasksMax=8
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=no
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
ReadOnlyPaths=/run
DevicePolicy=closed
DeviceAllow=block-* r
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
