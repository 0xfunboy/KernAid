[Unit]
Description=KernAid local user interface server
After=network.target kernaid-offline-inspector.socket kernaid-rescue-openai-executor.socket
Requires=kernaid-offline-inspector.socket kernaid-rescue-openai-executor.socket

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=kernaid-inspect kernaid-provider-client
WorkingDirectory=/opt/kernaid/desk
ExecStart=/usr/bin/python3 -I /usr/lib/kernaid/rescue_server.py
Environment=KERNAID_PRIVILEGED_INSPECTOR=1
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
