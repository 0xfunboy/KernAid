[Unit]
Description=KernAid local user interface server
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/kernaid/desk
ExecStart=/usr/bin/python3 -I /usr/lib/kernaid/rescue_server.py
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
