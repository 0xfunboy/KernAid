[Unit]
Description=KernAid QEMU-only provider lease probe connection
Requires=kernaid-provider-lease-probe.socket kernaid-rescue-vaultd.socket systemd-sysusers.service
BindsTo=kernaid-rescue-vaultd.service
After=kernaid-provider-lease-probe.socket kernaid-rescue-vaultd.socket kernaid-rescue-vaultd.service systemd-sysusers.service
CollectMode=inactive-or-failed
ConditionKernelCommandLine=boot=live
ConditionCredential=provider-lease-probe
ConditionPathExists=/run/credentials/@system/provider-lease-probe
ConditionPathExists=/sys/firmware/qemu_fw_cfg/by_name/opt/io.systemd.credentials/provider-lease-probe/raw
ConditionPathExists=/run/kernaid-rescue-vault/provider-lease-probe-validated-v1

[Service]
Type=simple
LoadCredential=provider-lease-probe
ExecCondition=/usr/bin/python3 -I -B -c 'import hashlib,pathlib,sys; data=pathlib.Path(sys.argv[1]).read_bytes(); sys.exit(not (len(data) == 15508 and hashlib.sha256(data).hexdigest() == "23470d54d04fd4d025988e9fabf7401b12c9157c6d58162295c01817c103a08f"))' ${CREDENTIALS_DIRECTORY}/provider-lease-probe
ExecStart=/usr/bin/python3 -I -B ${CREDENTIALS_DIRECTORY}/provider-lease-probe
RuntimeMaxSec=145s
TimeoutStartSec=5s
TimeoutStopSec=10s
Restart=no
StandardInput=socket
StandardOutput=null
StandardError=null
User=kernaid-openai
Group=kernaid-openai
SupplementaryGroups=kernaid-vault
UMask=0077
LimitCORE=0
LimitNOFILE=16
TasksMax=1
# Match the production executor's exact direct system.slice membership; the
# implicit per-template slice would be rejected by the lease validator.
Slice=system.slice
# The lease proof is subject to the same exact cgroup2 mount invariant as the
# production executor; a systemd PSI bind would make its mount view ambiguous.
MemoryPressureWatch=no
Delegate=pids
DelegateSubgroup=agent
KillMode=control-group
SendSIGKILL=yes
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
DevicePolicy=closed
InaccessiblePaths=/run/kernaid-rescue-openai-egress.sock
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
