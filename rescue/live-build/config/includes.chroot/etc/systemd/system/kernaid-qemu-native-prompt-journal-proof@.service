[Unit]
Description=KernAid QEMU-only native prompt full-journal proof (%i)
After=systemd-journald.service
ConditionKernelCommandLine=boot=live
ConditionPathExists=/sys/firmware/qemu_fw_cfg/by_name/opt/kernaid-native-vault-secret-digest/raw

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /usr/lib/kernaid/qemu_native_prompt_journal_probe.py %i
User=root
Group=root
StandardInput=null
StandardOutput=null
StandardError=null
TimeoutStartSec=25s
TimeoutStopSec=3s
UMask=0077
RuntimeDirectory=kernaid-qemu-native-prompt-journal-proof
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
LimitCORE=0
LimitNOFILE=32
TasksMax=4
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/run/kernaid-qemu-native-prompt-journal-proof
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
