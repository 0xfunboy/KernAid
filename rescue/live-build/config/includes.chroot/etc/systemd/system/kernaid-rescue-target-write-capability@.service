[Unit]
Description=KernAid candidate write-only target capability handoff
Requires=kernaid-rescue-target-write-capability.socket kernaid-rescue-vaultd.service kernaid-offline-inspector-key.service systemd-sysusers.service
After=kernaid-rescue-target-write-capability.socket kernaid-rescue-vaultd.service kernaid-offline-inspector-key.service systemd-sysusers.service
BindsTo=kernaid-rescue-vaultd.service
CollectMode=inactive-or-failed
ConditionKernelCommandLine=boot=live
ConditionKernelCommandLine=kernaid.repair=fstab-v1
ConditionPathExists=/usr/lib/kernaid/repair-candidate-image-v1
ConditionPathExists=/run/kernaid-offline-inspector/target-id.key
ConditionFileIsExecutable=/usr/sbin/e2fsck
ConditionFileIsExecutable=/usr/sbin/e2undo

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -B /usr/lib/kernaid/repair_target_handoff.py
Environment=KERNAID_TARGET_HANDOFF_PROFILE=write
Environment=KERNAID_TARGET_ID_KEY_FILE=/run/kernaid-offline-inspector/target-id.key
RuntimeMaxSec=210s
TimeoutStartSec=5s
TimeoutStopSec=2s
Restart=no
KillMode=control-group
SendSIGKILL=yes
StandardOutput=null
StandardError=null
User=root
Group=root
SupplementaryGroups=
UMask=0077
LimitCORE=0
LimitNOFILE=16
TasksMax=8
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=no
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
ReadOnlyPaths=/run /dev
ReadWritePaths=/run/lock/kernaid-repair
DevicePolicy=closed
DeviceAllow=block-* rw
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service fsopen fsconfig fsmount
SystemCallErrorNumber=EPERM
KeyringMode=private
RemoveIPC=yes
