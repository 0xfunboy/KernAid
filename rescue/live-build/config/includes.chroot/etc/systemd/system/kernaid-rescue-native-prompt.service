[Unit]
Description=KernAid Rescue closed native-prompt broker
Requires=kernaid-rescue-native-prompt.socket
After=kernaid-rescue-native-prompt.socket
ConditionKernelCommandLine=boot=live
ConditionKernelCommandLine=kernaid.native-prompt=vt-v1

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/lib/kernaid/rescue_native_prompt_broker.py
Sockets=kernaid-rescue-native-prompt.socket
Restart=on-failure
RestartSec=1s
TimeoutStartSec=5s
TimeoutStopSec=8s
KillMode=mixed
StandardOutput=null
StandardError=null
User=root
Group=root
RuntimeDirectory=kernaid-rescue-native-prompt
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
UMask=0077
LimitCORE=0
LimitNOFILE=32
TasksMax=8
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateIPC=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=all
ReadWritePaths=/run/kernaid-rescue-native-prompt
DevicePolicy=closed
DeviceAllow=/dev/tty0 rw
CapabilityBoundingSet=CAP_SYS_TTY_CONFIG
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
