#!/bin/sh
set -eu
base_url=http://127.0.0.1:4173
offline_inspection_smoke=0
offline_inspection_marker=/sys/firmware/qemu_fw_cfg/by_name/opt/kernaid-offline-inspection/raw
if [ -r "$offline_inspection_marker" ] \
    && python3 -c 'import pathlib,sys; data=pathlib.Path(sys.argv[1]).read_bytes(); sys.exit(data not in {b"v1", b"v1\0"})' "$offline_inspection_marker"; then
    offline_inspection_smoke=1
fi

fail() {
    printf '\nKERNAID_RESCUE_NOT_READY: %s\n' "$*" >/dev/ttyS0
    exit 1
}

secure_boot_smoke=0
secure_boot_probe=/sys/firmware/qemu_fw_cfg/by_name/opt/kernaid-secure-boot-probe/raw
if [ -e "$secure_boot_probe" ] || [ -L "$secure_boot_probe" ]; then
    if ! python3 -I - "$secure_boot_probe" <<'PY'
import os
import stat
import sys

descriptor = os.open(sys.argv[1], os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
try:
    metadata = os.fstat(descriptor)
    payload = os.read(descriptor, 4)
finally:
    os.close(descriptor)
if (
    not stat.S_ISREG(metadata.st_mode)
    or metadata.st_uid != 0
    or metadata.st_gid != 0
    or metadata.st_nlink != 1
    or stat.S_IMODE(metadata.st_mode) & 0o222
    or metadata.st_size not in (0, 2, 3)
    or payload not in (b"v1", b"v1\0")
):
    raise SystemExit(1)
PY
    then
        fail "Secure Boot probe marker failed its pinned content gate"
    fi
    secure_boot_smoke=1
fi

tauri_sandbox_smoke=0
tauri_sandbox_marker=/sys/firmware/qemu_fw_cfg/by_name/opt/kernaid-tauri-sandbox-probe/raw
if [ -e "$tauri_sandbox_marker" ] || [ -L "$tauri_sandbox_marker" ]; then
    if ! python3 -I - "$tauri_sandbox_marker" <<'PY'
