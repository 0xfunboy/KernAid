#!/bin/sh
set -eu
base_url=http://127.0.0.1:4173

fail() {
    echo "KERNAID_RESCUE_NOT_READY: $*" >/dev/ttyS0
    exit 1
}

if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
    fail "live user unexpectedly has passwordless root"
fi

index=
attempt=1
while [ "$attempt" -le 30 ]; do
    if index="$(curl --fail --silent --show-error --max-time 2 "$base_url/" 2>/dev/null)"; then
        break
    fi
    sleep 1
    attempt=$((attempt + 1))
done
test -n "$index" || fail "local UI server did not answer"

script_path="$(printf '%s' "$index" | sed -n 's/.*src="\.\/\([^"?]*\)".*/\1/p' | head -n 1)"
case "$script_path" in assets/*.js) ;; *) fail "JavaScript bundle path is missing" ;; esac
curl --fail --silent --show-error --max-time 10 "$base_url/$script_path" >/dev/null || fail "JavaScript bundle is unavailable"
inventory="$(curl --fail --silent --show-error --max-time 60 "$base_url/api/inventory")" || fail "inventory endpoint failed"
printf '%s' "$inventory" | grep -q '"collector": "system.hostname"' || fail "hostname evidence is missing"
printf '%s' "$inventory" | grep -q '"collector": "linux.block.inventory"' || fail "storage evidence is missing"
fingerprint="$(printf '%s' "$inventory" | python3 -c 'import hashlib,json,sys; items=json.load(sys.stdin); selected=[item for item in items if "hostname" in item["collector"] or "block.inventory" in item["collector"] or item["collector"].endswith(".disks") or item["collector"].endswith(".system") or item["collector"].endswith(".storage.identity")]; all(item.get("success") is True for item in selected) or sys.exit("identity collector failed"); canonical="\0".join(item["collector"] + "\0" + item["output"] for item in selected); print("sha256:" + hashlib.sha256(canonical.encode()).hexdigest())')" || fail "target fingerprint failed"
request="$(python3 -c 'import json,sys; print(json.dumps({"sessionId":"S-qemu-readiness","planId":"P-qemu-readiness","targetFingerprint":sys.argv[1],"sequence":1,"action":"system.observe.noop"}))' "$fingerprint")"
authorization="$(curl --fail --silent --show-error --max-time 60 -H 'Origin: http://127.0.0.1:4173' -H 'Content-Type: application/json' --data "$request" "$base_url/api/authorize-observe")" || fail "R0 authorization endpoint failed"
printf '%s' "$authorization" | grep -q '"status":"observed"' || fail "R0 authorization was not accepted"
echo KERNAID_RESCUE_READY >/dev/ttyS0
