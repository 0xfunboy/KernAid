    then
        fail "Tauri sandbox probe marker failed its pinned content gate"
    fi
    tauri_sandbox_smoke=1
fi

fail_vaultd_startup() {
    vaultd_startup_status="$(
        /usr/bin/timeout --signal=TERM --kill-after=1s 5s \
            /usr/bin/systemctl show --property=StatusText --value \
            kernaid-rescue-vaultd.service 2>/dev/null \
            | /usr/bin/head -c 65
        printf '.'
    )"
    case "$vaultd_startup_status" in
        "$(printf '\n.')")
            fail "vault lifecycle daemon startup stage is unavailable"
            ;;
        "$(printf 'KERNAID_RESCUE_VAULT_STARTUP_V1 stage=identity\n.')")
            fail "vault lifecycle daemon last reported startup stage identity"
            ;;
        "$(printf 'KERNAID_RESCUE_VAULT_STARTUP_V1 stage=listener\n.')")
            fail "vault lifecycle daemon last reported startup stage listener"
            ;;
        "$(printf 'KERNAID_RESCUE_VAULT_STARTUP_V1 stage=runtime\n.')")
            fail "vault lifecycle daemon last reported startup stage runtime"
            ;;
        "$(printf 'KERNAID_RESCUE_VAULT_STARTUP_V1 stage=rng\n.')")
            fail "vault lifecycle daemon last reported startup stage rng"
            ;;
        "$(printf 'KERNAID_RESCUE_VAULT_STARTUP_V1 stage=worker-cgroup\n.')")
            fail "vault lifecycle daemon last reported startup stage worker-cgroup"
            ;;
        "$(printf 'KERNAID_RESCUE_VAULT_STARTUP_V1 stage=worker-bootstrap\n.')")
            fail "vault lifecycle daemon last reported startup stage worker-bootstrap"
            ;;
        "$(printf 'KERNAID_RESCUE_VAULT_STARTUP_V1 stage=worker-caps\n.')")
            fail "vault lifecycle daemon last reported startup stage worker-caps"
            ;;
        "$(printf 'KERNAID_RESCUE_VAULT_STARTUP_V1 stage=worker-probe\n.')")
            fail "vault lifecycle daemon last reported startup stage worker-probe"
            ;;
        "$(printf 'KERNAID_RESCUE_VAULT_STARTUP_V1 stage=caps-final\n.')")
            fail "vault lifecycle daemon last reported startup stage caps-final"
            ;;
        "$(printf 'KERNAID_RESCUE_VAULT_STARTUP_V1 stage=ready\n.')")
            fail "vault lifecycle daemon last reported startup stage ready"
            ;;
        *)
            fail "vault lifecycle daemon startup stage is unavailable"
            ;;
    esac
}

provider_probe_raw=/sys/firmware/qemu_fw_cfg/by_name/opt/io.systemd.credentials/provider-lease-probe/raw
provider_probe_system=/run/credentials/@system/provider-lease-probe
provider_probe_marker=/run/kernaid-rescue-vault/provider-lease-probe-validated-v1
provider_probe_enabled=0
raw_present=0
system_present=0
if [ -e "$provider_probe_raw" ] || [ -L "$provider_probe_raw" ]; then
    raw_present=1
fi
if [ -e "$provider_probe_system" ] || [ -L "$provider_probe_system" ]; then
    system_present=1
fi
if [ "$raw_present" != "$system_present" ]; then
    fail "QEMU provider probe credential is only partially imported"
fi
if [ "$raw_present" = "1" ]; then
    if ! python3 - "$provider_probe_raw" "$provider_probe_system" "$provider_probe_marker" <<'PY'
import hashlib
import os
import stat
import sys

EXPECTED_SIZE = 15508
EXPECTED_SHA256 = "23470d54d04fd4d025988e9fabf7401b12c9157c6d58162295c01817c103a08f"
MARKER = b"v1\n"


def pinned_read(path: str, *, expected_stat_size: int) -> bytes:
    before = os.lstat(path)
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        after = os.fstat(descriptor)
        if (
            (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino)
            or not stat.S_ISREG(after.st_mode)
            or after.st_uid != 0
            or after.st_gid != 0
            or after.st_nlink != 1
            or stat.S_IMODE(after.st_mode) & 0o222
            or after.st_size != expected_stat_size
        ):
            raise RuntimeError
        chunks = bytearray()
        while len(chunks) <= EXPECTED_SIZE:
            block = os.read(descriptor, EXPECTED_SIZE + 1 - len(chunks))
            if not block:
                break
            chunks.extend(block)
        if len(chunks) != EXPECTED_SIZE:
            raise RuntimeError
        value = bytes(chunks)
        chunks[:] = b"\0" * len(chunks)
        if hashlib.sha256(value).hexdigest() != EXPECTED_SHA256:
            raise RuntimeError
        return value
    finally:
        os.close(descriptor)


def create_or_validate_marker(path: str) -> None:
    directory_path, name = os.path.split(path)
    directory = os.open(
        directory_path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    )
    try:
        metadata = os.fstat(directory)
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o700
        ):
            raise RuntimeError
        try:
            marker = os.open(
                name,
                os.O_WRONLY
                | os.O_CREAT
                | os.O_EXCL
                | os.O_CLOEXEC
                | os.O_NOFOLLOW,
                0o600,
                dir_fd=directory,
            )
            try:
                if os.write(marker, MARKER) != len(MARKER):
                    raise RuntimeError
                os.fchmod(marker, 0o600)
            finally:
                os.close(marker)
        except FileExistsError:
            pass
        marker = os.open(
            name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=directory
        )
        try:
            metadata = os.fstat(marker)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != 0
                or metadata.st_gid != 0
                or metadata.st_nlink != 1
                or stat.S_IMODE(metadata.st_mode) != 0o600
                or metadata.st_size != len(MARKER)
                or os.read(marker, len(MARKER) + 1) != MARKER
            ):
                raise RuntimeError
        finally:
            os.close(marker)
    finally:
        os.close(directory)


try:
    # qemu_fw_cfg's sysfs bin_attribute intentionally reports st_size=0;
    # systemd reads its sibling size attribute before copying the exact bytes
    # into the regular @system credential file.
    raw = pinned_read(sys.argv[1], expected_stat_size=0)
    imported = pinned_read(sys.argv[2], expected_stat_size=EXPECTED_SIZE)
    if raw != imported:
        raise RuntimeError
    create_or_validate_marker(sys.argv[3])
except BaseException:
    raise SystemExit(1)
PY
    then
        fail "QEMU provider probe credential failed its pinned content gate"
    fi
    provider_probe_enabled=1
fi

test "$(id -u kernaid 2>/dev/null)" = "1000" || fail "live user is not exact UID 1000"
id -nG kernaid 2>/dev/null | tr ' ' '\n' | grep -Fxq kernaid-vault \
    || fail "live user is not a kernaid-vault member"
if id -nG kernaid 2>/dev/null | tr ' ' '\n' | grep -Fxq kernaid-provider-client; then
    fail "live user unexpectedly has provider-client access"
fi
if id -nG kernaid 2>/dev/null | tr ' ' '\n' | grep -Fxq kernaid-application-client; then
    fail "live user unexpectedly has Application relay client access"
fi
id -nG kernaid 2>/dev/null | tr ' ' '\n' | grep -Fxq kernaid-codex-client \
    || fail "live user cannot access the Codex authentication bridge"
if id -nG kernaid 2>/dev/null | tr ' ' '\n' | grep -Fxq kernaid-codex; then
    fail "live user unexpectedly has the Codex executor identity"
fi
repair_identity="$(getent passwd | awk -F: '$1 == "kernaid-repair" { count += 1; if (NF == 7 && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ && $3 == $4 && $3 != 0 && $3 != 1000 && $5 == "KernAid Rescue repair broker" && $6 == "/nonexistent" && $7 == "/usr/sbin/nologin") identity = $3 ":" $4 } END { if (count == 1 && identity != "") print identity }')"
test -n "$repair_identity" || fail "repair broker identity is missing or unsafe"
repair_group_id="${repair_identity#*:}"
getent passwd | awk -F: -v id="$repair_group_id" '$3 == id || $4 == id { count += 1; if ($1 != "kernaid-repair" || $3 != id || $4 != id) bad = 1 } END { exit !(count == 1 && !bad) }' \
    || fail "repair broker numeric identity collides with another account"
getent group | awk -F: -v gid="$repair_group_id" '$1 == "kernaid-repair" || $3 == gid { count += 1; if (NF != 4 || $1 != "kernaid-repair" || $3 != gid || $4 != "") bad = 1 } END { exit !(count == 1 && !bad) }' \
    || fail "repair broker group is missing, colliding, or has static members"
repair_groups="$(id -nG kernaid-repair 2>/dev/null)" \
    || fail "repair broker group membership is unavailable"
test "$repair_groups" = "kernaid-repair" \
    || fail "repair broker has a persistent supplementary group membership"
for repair_forbidden_member in \
    kernaid \
    kernaid-rescue-ui \
    kernaid-openai \
    kernaid-openai-egress \
    kernaid-application \
    kernaid-codex
do
    repair_forbidden_groups="$(id -nG "$repair_forbidden_member" 2>/dev/null)" \
        || fail "repair broker isolation peer identity is unavailable"
    if printf '%s\n' "$repair_forbidden_groups" | tr ' ' '\n' | grep -Fxq kernaid-repair; then
        fail "live, UI, or provider identity unexpectedly has repair broker access"
    fi
done
codex_identity="$(getent passwd kernaid-codex | awk -F: 'NF == 7 && $1 == "kernaid-codex" && $3 == 973 && $4 == 973 && $6 == "/nonexistent" && $7 == "/usr/sbin/nologin" { print $3 ":" $4 }')"
test "$codex_identity" = "973:973" || fail "Codex Agent identity is missing or unsafe"
getent group kernaid-codex | awk -F: 'NF == 4 && $1 == "kernaid-codex" && $3 == 973 && $4 == "" { found = 1 } END { exit !found }' \
    || fail "Codex Agent group has an unsafe identity or supplementary member"
getent passwd | awk -F: '$3 == 973 || $4 == 973 { count += 1; if ($1 != "kernaid-codex" || $3 != 973 || $4 != 973) bad = 1 } END { exit !(count == 1 && !bad) }' \
    || fail "Codex Agent numeric identity collides with another account"
codex_client_group_id="$(getent group kernaid-codex-client | awk -F: 'NF == 4 && $1 == "kernaid-codex-client" && $3 ~ /^[0-9]+$/ { print $3 }')"
test -n "$codex_client_group_id" || fail "Codex client group is missing"
getent group kernaid-codex-client | awk -F: 'NF == 4 { count = split($4, members, ","); if (count == 1 && members[1] == "kernaid") found = 1 } END { exit !found }' \
    || fail "Codex client group authorizes an unexpected identity"
if id -nG kernaid-codex 2>/dev/null | tr ' ' '\n' | grep -E -x 'kernaid-vault|kernaid-provider-client|kernaid-codex-client'; then
    fail "Codex Agent has a persistent privileged group membership"
fi
openai_identity="$(getent passwd kernaid-openai | awk -F: 'NF == 7 && $1 == "kernaid-openai" && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ && $3 == $4 && $3 != 0 && $3 != 1000 && $6 == "/nonexistent" && $7 == "/usr/sbin/nologin" { print $3 ":" $4 }')"
test -n "$openai_identity" || fail "OpenAI Agent identity is missing or unsafe"
openai_group_id="${openai_identity#*:}"
getent group kernaid-openai | awk -F: -v gid="$openai_group_id" 'NF == 4 && $1 == "kernaid-openai" && $3 == gid && $4 == "" { found = 1 } END { exit !found }' \
    || fail "OpenAI Agent group has an unsafe identity or supplementary member"
getent passwd | awk -F: -v gid="$openai_group_id" '$4 == gid { count += 1; if ($1 != "kernaid-openai") bad = 1 } END { exit !(count == 1 && !bad) }' \
    || fail "OpenAI Agent group authorizes another primary identity"
application_identity="$(getent passwd kernaid-application | awk -F: 'NF == 7 && $1 == "kernaid-application" && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ && $3 == $4 && $3 != 0 && $3 != 1000 && $6 == "/nonexistent" && $7 == "/usr/sbin/nologin" { print $3 ":" $4 }')"
test -n "$application_identity" || fail "Application Agent identity is missing or unsafe"
test "$application_identity" != "$openai_identity" || fail "Application and OpenAI Agent identities are not distinct"
application_group_id="${application_identity#*:}"
getent group kernaid-application | awk -F: -v gid="$application_group_id" 'NF == 4 && $1 == "kernaid-application" && $3 == gid && $4 == "" { found = 1 } END { exit !found }' \
    || fail "Application Agent group has an unsafe identity or supplementary member"
getent passwd | awk -F: -v gid="$application_group_id" '$4 == gid { count += 1; if ($1 != "kernaid-application") bad = 1 } END { exit !(count == 1 && !bad) }' \
    || fail "Application Agent group authorizes another primary identity"
id -nG kernaid-application 2>/dev/null | tr ' ' '\n' | grep -Fxq kernaid-vault \
    || fail "Application Agent is not a kernaid-vault member"
if id -nG kernaid-application 2>/dev/null | tr ' ' '\n' | grep -E -x 'kernaid-application-client|kernaid-provider-client|kernaid-codex-client|kernaid-codex|kernaid-openai'; then
    fail "Application Agent has a forbidden persistent group membership"
fi
application_client_group_id="$(getent group kernaid-application-client | awk -F: 'NF == 4 && $1 == "kernaid-application-client" && $3 ~ /^[0-9]+$/ && $4 == "" { print $3 }')"
test -n "$application_client_group_id" || fail "Application relay client group is missing or has static members"
getent group kernaid-vault | awk -F: 'NF == 4 && $1 == "kernaid-vault" { count = split($4, members, ","); for (member_index = 1; member_index <= count; member_index += 1) { seen[members[member_index]] += 1 } if (count == 3 && seen["kernaid"] == 1 && seen["kernaid-openai"] == 1 && seen["kernaid-application"] == 1) found = 1 } END { exit !found }' \
    || fail "vault group does not have the exact companion and Agent members"
if id -nG kernaid 2>/dev/null | tr ' ' '\n' | grep -Fxq kernaid-openai; then
    fail "live user unexpectedly has OpenAI egress access"
fi
egress_identity="$(getent passwd kernaid-openai-egress | awk -F: 'NF == 7 && $1 == "kernaid-openai-egress" && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ && $3 == $4 && $3 != 0 && $3 != 1000 && $6 == "/nonexistent" && $7 == "/usr/sbin/nologin" { print $3 ":" $4 }')"
test -n "$egress_identity" || fail "OpenAI egress proxy identity is missing or unsafe"
test "$egress_identity" != "$openai_identity" || fail "OpenAI Agent and egress proxy identities are not distinct"
id -nG kernaid-openai 2>/dev/null | tr ' ' '\n' | grep -Fxq kernaid-vault \
    || fail "OpenAI Agent is not a kernaid-vault member"
if id -nG kernaid-openai 2>/dev/null | tr ' ' '\n' | grep -Fxq kernaid-provider-client; then
    fail "OpenAI Agent unexpectedly has provider-client access"
fi
for forbidden_group in kernaid-vault kernaid-provider-client kernaid-openai; do
    if id -nG kernaid-openai-egress 2>/dev/null | tr ' ' '\n' | grep -Fxq "$forbidden_group"; then
        fail "OpenAI egress proxy has forbidden group access"
    fi
done
for subordinate_ids in /etc/subuid /etc/subgid; do
    if [ -r "$subordinate_ids" ] \
        && grep -Eq '^(kernaid|kernaid-application|kernaid-codex|kernaid-openai|kernaid-openai-egress):' "$subordinate_ids"; then
        fail "Rescue identities unexpectedly have subordinate IDs"
    fi
done
for helper in /usr/bin/newuidmap /usr/bin/newgidmap; do
    if [ -u "$helper" ] || [ -g "$helper" ]; then
        fail "uidmap helper unexpectedly has a set-ID bit"
    fi
done
test -r /proc/sys/kernel/core_pattern || fail "kernel core policy is unreadable"
test -z "$(cat /proc/sys/kernel/core_pattern)" || fail "kernel core filename is enabled"
test "$(cat /proc/sys/kernel/core_uses_pid)" = "0" || fail "kernel core PID suffix is enabled"
test -r /proc/sys/kernel/printk || fail "kernel console policy is unreadable"
printk_policy="$(
    /usr/bin/head -c 65 /proc/sys/kernel/printk || exit 1
    printf '.'
)" || fail "kernel console policy is unavailable"
test "$printk_policy" = "$(printf '5\t4\t1\t7\n.')" \
    || fail "kernel console policy is unsafe"
test "$(wc -l < /proc/swaps)" -eq 1 || fail "swap is active"
vaultd_active_state="$(systemctl show --property=ActiveState --value kernaid-rescue-vaultd.service)" \
    || fail "vault lifecycle daemon state is unavailable"
if [ "$vaultd_active_state" != "active" ]; then
    fail_vaultd_startup
fi
test "$(systemctl show --property=ActiveState --value kernaid-rescue-vaultd.socket)" = "active" \
    || fail "vault lifecycle socket is not active"
vault_socket_substate="$(systemctl show --property=SubState --value kernaid-rescue-vaultd.socket)" \
    || fail "vault lifecycle socket state is unavailable"
case "$vault_socket_substate" in
    listening|running) ;;
    *) fail "vault lifecycle socket is not operational" ;;
esac
vault_group_id="$(getent group kernaid-vault | awk -F: 'NF == 4 && $1 == "kernaid-vault" { print $3 }')"
test -n "$vault_group_id" || fail "vault lifecycle group is missing"
test -S /run/kernaid-rescue-vault.sock || fail "vault lifecycle pathname is not a socket"
test "$(stat -c '%u:%g:%a:%h' -- /run/kernaid-rescue-vault.sock)" = "0:${vault_group_id}:660:1" \
    || fail "vault lifecycle socket ownership or mode is unsafe"
test "$(systemctl show --property=ActiveState --value kernaid-rescue-application.socket)" = "active" \
    || fail "Application relay socket is not active"
application_socket_substate="$(systemctl show --property=SubState --value kernaid-rescue-application.socket)" \
    || fail "Application relay socket state is unavailable"
case "$application_socket_substate" in
    listening|running) ;;
    *) fail "Application relay socket is not operational" ;;
esac
test -S /run/kernaid-rescue-application.sock || fail "Application relay pathname is not a socket"
test "$(stat -c '%u:%g:%a:%h' -- /run/kernaid-rescue-application.sock)" = "0:${application_client_group_id}:660:1" \
    || fail "Application relay socket ownership or mode is unsafe"
test "$(systemctl show --property=ActiveState --value kernaid-rescue-openai-egress.socket)" = "active" \
    || fail "OpenAI egress socket is not active"
egress_socket_substate="$(systemctl show --property=SubState --value kernaid-rescue-openai-egress.socket)" \
    || fail "OpenAI egress socket state is unavailable"
case "$egress_socket_substate" in
    listening|running) ;;
    *) fail "OpenAI egress socket is not operational" ;;
esac
test -S /run/kernaid-rescue-openai-egress.sock || fail "OpenAI egress pathname is not a socket"
test "$(stat -c '%u:%g:%a:%h' -- /run/kernaid-rescue-openai-egress.sock)" = "0:${openai_group_id}:660:1" \
    || fail "OpenAI egress socket ownership or mode is unsafe"
test "$(systemctl show --property=ActiveState --value kernaid-rescue-openai-executor.socket)" = "active" \
    || fail "OpenAI executor socket is not active"
provider_socket_substate="$(systemctl show --property=SubState --value kernaid-rescue-openai-executor.socket)" \
    || fail "OpenAI executor socket state is unavailable"
case "$provider_socket_substate" in
    listening|running) ;;
    *) fail "OpenAI executor socket is not operational" ;;
esac
provider_group_id="$(getent group kernaid-provider-client | awk -F: 'NF == 4 && $1 == "kernaid-provider-client" { print $3 }')"
test -n "$provider_group_id" || fail "provider-client group is missing"
test -S /run/kernaid-rescue-openai.sock || fail "OpenAI executor pathname is not a socket"
test "$(stat -c '%u:%g:%a:%h' -- /run/kernaid-rescue-openai.sock)" = "0:${provider_group_id}:660:1" \
    || fail "OpenAI executor socket ownership or mode is unsafe"
test "$(systemctl show --property=ActiveState --value kernaid-rescue-codex.socket)" = "active" \
    || fail "Codex authentication bridge socket is not active"
codex_socket_substate="$(systemctl show --property=SubState --value kernaid-rescue-codex.socket)" \
    || fail "Codex authentication bridge socket state is unavailable"
case "$codex_socket_substate" in
    listening|running) ;;
    *) fail "Codex authentication bridge socket is not operational" ;;
esac
test -S /run/kernaid-rescue-codex.sock || fail "Codex authentication bridge pathname is not a socket"
test "$(stat -c '%u:%g:%a:%h' -- /run/kernaid-rescue-codex.sock)" = "0:${codex_client_group_id}:660:1" \
    || fail "Codex authentication bridge socket ownership or mode is unsafe"
test "$(systemctl show --property=ActiveState --value kernaid-rescue-codex-mounter.socket)" = "active" \
    || fail "Codex mount broker socket is not active"
codex_mounter_substate="$(systemctl show --property=SubState --value kernaid-rescue-codex-mounter.socket)" \
    || fail "Codex mount broker socket state is unavailable"
case "$codex_mounter_substate" in
    listening|running) ;;
    *) fail "Codex mount broker socket is not operational" ;;
esac
test -S /run/kernaid-rescue-codex-mounter.sock || fail "Codex mount broker pathname is not a socket"
test "$(stat -c '%u:%g:%a:%h' -- /run/kernaid-rescue-codex-mounter.sock)" = "0:0:600:1" \
    || fail "Codex mount broker socket ownership or mode is unsafe"
for codex_helper in \
    /usr/lib/kernaid/kernaid-rescue-codex \
    /usr/lib/kernaid/kernaid-rescue-codex-mounter \
    /usr/bin/kernaid-codex-auth; do
    test "$(stat -c '%F:%u:%g:%a:%h' -- "$codex_helper")" = "regular file:0:0:755:1" \
