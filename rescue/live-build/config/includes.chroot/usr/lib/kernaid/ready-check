#!/bin/sh
set -eu
base_url=http://127.0.0.1:4173
offline_inspection_smoke=0
offline_inspection_marker=/sys/firmware/qemu_fw_cfg/by_name/opt/kernaid-offline-inspection/raw
if [ -r "$offline_inspection_marker" ] \
    && python3 -c 'import pathlib,sys; data=pathlib.Path(sys.argv[1]).read_bytes(); sys.exit(data not in {b"v1", b"v1\0"})' "$offline_inspection_marker"; then
    offline_inspection_smoke=1
fi

fail() {
    echo "KERNAID_RESCUE_NOT_READY: $*" >/dev/ttyS0
    exit 1
}

test "$(id -u kernaid 2>/dev/null)" = "1000" || fail "live user is not exact UID 1000"
id -nG kernaid 2>/dev/null | tr ' ' '\n' | grep -Fxq kernaid-vault \
    || fail "live user is not a kernaid-vault member"
for subordinate_ids in /etc/subuid /etc/subgid; do
    if [ -r "$subordinate_ids" ] && grep -q '^kernaid:' "$subordinate_ids"; then
        fail "live user unexpectedly has subordinate IDs"
    fi
done
for helper in /usr/bin/newuidmap /usr/bin/newgidmap; do
    if [ -u "$helper" ] || [ -g "$helper" ]; then
        fail "uidmap helper unexpectedly has a set-ID bit"
    fi
done
test -r /proc/sys/kernel/core_pattern || fail "kernel core policy is unreadable"
test -z "$(cat /proc/sys/kernel/core_pattern)" || fail "kernel core filename is enabled"
test "$(cat /proc/sys/kernel/core_uses_pid)" = "0" || fail "kernel core PID suffix is enabled"
test "$(wc -l < /proc/swaps)" -eq 1 || fail "swap is active"
test "$(systemctl show --property=ActiveState --value kernaid-rescue-vaultd.service)" = "active" \
    || fail "vault lifecycle daemon is not active"
test "$(systemctl show --property=ActiveState --value kernaid-rescue-vaultd.socket)" = "active" \
    || fail "vault lifecycle socket is not active"
vault_socket_substate="$(systemctl show --property=SubState --value kernaid-rescue-vaultd.socket)" \
    || fail "vault lifecycle socket state is unavailable"
case "$vault_socket_substate" in
    listening|running) ;;
    *) fail "vault lifecycle socket is not operational" ;;
esac
vault_group_id="$(getent group kernaid-vault | awk -F: 'NF == 4 && $1 == "kernaid-vault" { print $3 }')"
test -n "$vault_group_id" || fail "vault lifecycle group is missing"
test -S /run/kernaid-rescue-vault.sock || fail "vault lifecycle pathname is not a socket"
test "$(stat -c '%u:%g:%a:%h' -- /run/kernaid-rescue-vault.sock)" = "0:${vault_group_id}:660:1" \
    || fail "vault lifecycle socket ownership or mode is unsafe"

if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
    fail "live user unexpectedly has passwordless root"
fi

index=
attempt=1
while [ "$attempt" -le 30 ]; do
    if index="$(curl --fail --silent --show-error --max-time 2 "$base_url/" 2>/dev/null)"; then
        break
    fi
    sleep 1
    attempt=$((attempt + 1))
done
test -n "$index" || fail "local UI server did not answer"

script_path="$(printf '%s' "$index" | sed -n 's/.*src="\.\/\([^"?]*\)".*/\1/p' | head -n 1)"
case "$script_path" in assets/*.js) ;; *) fail "JavaScript bundle path is missing" ;; esac
curl --fail --silent --show-error --max-time 10 "$base_url/$script_path" >/dev/null || fail "JavaScript bundle is unavailable"
inventory="$(curl --fail --silent --show-error --max-time 5 --retry 12 --retry-all-errors --retry-max-time 60 "$base_url/api/inventory")" || fail "inventory endpoint failed"
printf '%s' "$inventory" | grep -q '"collector": "system.hostname"' || fail "hostname evidence is missing"
printf '%s' "$inventory" | grep -q '"collector": "linux.block.inventory"' || fail "storage evidence is missing"
fingerprint="$(printf '%s' "$inventory" | python3 -c 'import hashlib,json,sys; items=json.load(sys.stdin); selected=[item for item in items if "hostname" in item["collector"] or "block.inventory" in item["collector"] or item["collector"].endswith(".disks") or item["collector"].endswith(".system") or item["collector"].endswith(".storage.identity")]; selected and all(item.get("success") is True and item.get("truncated") is False for item in selected) or sys.exit("identity collector failed"); canonical="\0".join(item["collector"] + "\0" + item["output"] for item in selected); print("sha256:" + hashlib.sha256(canonical.encode()).hexdigest())')" || fail "runtime inventory fingerprint failed"
targets="$(curl --fail --silent --show-error --max-time 5 --retry 12 --retry-all-errors --retry-max-time 60 "$base_url/api/rescue/installed-targets")" || fail "installed-target metadata endpoint failed"
printf '%s' "$targets" | python3 -c 'import json,sys; data=json.load(sys.stdin); claims=data.get("claims", {}); data.get("apiVersion") == "kernaid.dev/rescue-targets/v1alpha1" or sys.exit("unexpected target API version"); data.get("mode") == "observe-r0" or sys.exit("target scan is not R0"); data.get("identifierScope") == "ephemeral-rescue-boot" or sys.exit("target identifiers do not share the boot epoch"); all(claims.get(key) is False for key in ("installedOsConfirmed", "filesystemContentInspected", "mountOperationPerformed", "mutationPerformed", "rawDeviceIdentifiersReturned")) or sys.exit("unsafe target scan claim"); all(item.get("selectionEligible") is True and item.get("confidence") == "low" and item.get("status") == "unverified-installation-candidate" and item.get("inspectionMode") == "metadata-only-no-mount" for item in data.get("candidates", [])) or sys.exit("unsafe target candidate"); all(item.get("selectionEligible") is False for item in data.get("disks", []) if item.get("mounted") is True) or sys.exit("mounted target is selectable")' || fail "installed-target metadata contract failed"
selection_request="$(printf '%s' "$targets" | python3 -c 'import json,sys; data=json.load(sys.stdin); candidates=[item for item in data.get("candidates", []) if item.get("osFamilyHint") == "linux"]; print(json.dumps({"scanFingerprint":data["scanFingerprint"],"targetId":candidates[0]["targetId"]}, separators=(",", ":"))) if candidates else None')" || fail "installed-target selection request failed"
if [ -n "$selection_request" ]; then
    selection="$(curl --fail --silent --show-error --max-time 22 -H 'Origin: http://127.0.0.1:4173' -H 'Content-Type: application/json' --data "$selection_request" "$base_url/api/rescue/select-installed-target")" || fail "installed-target selection endpoint failed"
    printf '%s' "$selection" | python3 -c 'import json,sys; request=json.loads(sys.argv[1]); data=json.load(sys.stdin); target=data.get("target", {}); claims=data.get("claims", {}); data.get("status") == "observe-target-validated" or sys.exit("target selection was not validated"); data.get("scanFingerprint") == request.get("scanFingerprint") or sys.exit("selection fingerprint binding failed"); target.get("targetId") == request.get("targetId") or sys.exit("selection target binding failed"); target.get("selectionEligible") is True or sys.exit("selected target is not eligible"); target.get("confidence") == "low" and target.get("status") == "unverified-installation-candidate" or sys.exit("selected target claim is too strong"); target.get("inspectionMode") == "metadata-only-no-mount" or sys.exit("selected target is not metadata-only"); all(claims.get(key) is False for key in ("installedOsConfirmed", "filesystemContentInspected", "mountOperationPerformed", "mutationPerformed")) or sys.exit("unsafe target selection claim")' "$selection_request" || fail "installed-target selection contract failed"
    composite_fingerprint="$(printf '%s' "$selection" | python3 -c 'import hashlib,json,sys; inventory_fingerprint=sys.argv[1]; data=json.load(sys.stdin); scan_fingerprint=data["scanFingerprint"]; candidate=data["target"]; target_id=candidate["targetId"]; candidate_json=json.dumps(candidate, ensure_ascii=True, sort_keys=True, separators=(",", ":")); material="\0".join(("kernaid-rescue-observe-target-v1", inventory_fingerprint, scan_fingerprint, target_id, candidate_json)); print("sha256:" + hashlib.sha256(material.encode("utf-8")).hexdigest())' "$fingerprint")" || fail "composite Rescue target fingerprint failed"
    request="$(python3 -c 'import json,sys; rescue_target=json.loads(sys.argv[2]); set(rescue_target) == {"scanFingerprint", "targetId"} or sys.exit("invalid Rescue target reference"); print(json.dumps({"sessionId":"S-qemu-readiness","planId":"P-qemu-readiness","targetFingerprint":sys.argv[1],"sequence":1,"action":"system.observe.noop","rescueTarget":rescue_target}, separators=(",", ":")))' "$composite_fingerprint" "$selection_request")" || fail "bound R0 authorization request failed"
    authorization="$(curl --fail --silent --show-error --max-time 22 -H 'Origin: http://127.0.0.1:4173' -H 'Content-Type: application/json' --data "$request" "$base_url/api/authorize-observe")" || fail "bound R0 authorization endpoint failed"
    printf '%s' "$authorization" | grep -q '"status":"observed"' || fail "bound R0 authorization was not accepted"
    if [ "$offline_inspection_smoke" = "1" ]; then
        inspection="$(curl --fail --silent --show-error --max-time 22 -H 'Origin: http://127.0.0.1:4173' -H 'Content-Type: application/json' --data "$selection_request" "$base_url/api/rescue/inspect-installed-target")" || fail "read-only Linux target inspection failed"
        printf '%s' "$inspection" | python3 -c 'import json,sys; request=json.loads(sys.argv[1]); data=json.load(sys.stdin); target=data.get("target", {}); policy=data.get("inspection", {}); claims=data.get("claims", {}); installed=data.get("os", {}); data.get("apiVersion") == "kernaid.dev/rescue-offline-inspection/v1alpha1" or sys.exit("unexpected offline inspection API version"); data.get("status") == "installed-os-content-inspected" or sys.exit("Linux fixture installation was not confirmed"); data.get("trust") == "observed-untrusted" or sys.exit("inspection trust classification is missing"); target.get("scanFingerprint") == request.get("scanFingerprint") and target.get("targetId") == request.get("targetId") or sys.exit("inspection target binding failed"); target.get("osFamily") == "linux" and target.get("filesystem") == "ext4" or sys.exit("unexpected Linux fixture target type"); policy.get("mode") == "temporary-read-only-no-replay" and policy.get("journalReplayPrevented") is True and policy.get("privateMountNamespace") is True and policy.get("deviceOpenedReadOnly") is True and policy.get("rawDeviceIdentifierReturned") is False or sys.exit("unsafe inspection mount policy"); policy.get("filesystemOptions") == ["noload"] or sys.exit("ext4 journal replay is not disabled"); all(claims.get(key) is True for key in ("installedOsConfirmed", "filesystemContentInspected", "mountOperationAttempted", "mountOperationPerformed", "mountCleanupVerified")) or sys.exit("Linux inspection success claims are incomplete"); all(claims.get(key) is False for key in ("autoUnlockAttempted", "mutationPerformed", "diagnosisProduced", "repairAttempted")) or sys.exit("Linux inspection made an unsafe claim"); installed.get("family") == "linux" and installed.get("installationConfirmed") is True and installed.get("release", {}).get("id") == "kernaid-qemu-fixture" and installed.get("boot", {}).get("kernelArtifactCount") == 1 or sys.exit("Linux fixture corpus was not inspected")' "$selection_request" || fail "read-only Linux target inspection contract failed"
        windows_selection_request="$(printf '%s' "$targets" | python3 -c 'import json,sys; data=json.load(sys.stdin); disks={item.get("id"):item for item in data.get("disks", [])}; candidates=[item for item in data.get("candidates", []) if item.get("osFamilyHint") == "windows" and item.get("diskId") in disks and disks[item["diskId"]].get("partitionTable") == "gpt" and item.get("sourceRef", "").startswith(disks[item["diskId"]].get("ref", "") + "/volume-")]; len(candidates) == 1 or sys.exit("one GPT partition Windows fixture target is required"); print(json.dumps({"scanFingerprint":data["scanFingerprint"],"targetId":candidates[0]["targetId"]}, separators=(",", ":")))')" || fail "Windows GPT target selection request failed"
        windows_selection="$(curl --fail --silent --show-error --max-time 22 -H 'Origin: http://127.0.0.1:4173' -H 'Content-Type: application/json' --data "$windows_selection_request" "$base_url/api/rescue/select-installed-target")" || fail "Windows target selection endpoint failed"
        printf '%s' "$windows_selection" | python3 -c 'import json,sys; request=json.loads(sys.argv[1]); data=json.load(sys.stdin); target=data.get("target", {}); data.get("status") == "observe-target-validated" and data.get("scanFingerprint") == request.get("scanFingerprint") and target.get("targetId") == request.get("targetId") and target.get("osFamilyHint") == "windows" or sys.exit("Windows target binding failed")' "$windows_selection_request" || fail "Windows target selection contract failed"
        windows_inspection="$(curl --fail --silent --show-error --max-time 22 -H 'Origin: http://127.0.0.1:4173' -H 'Content-Type: application/json' --data "$windows_selection_request" "$base_url/api/rescue/inspect-installed-target")" || fail "read-only Windows target inspection failed"
        printf '%s' "$windows_inspection" | python3 -c 'import json,sys; request=json.loads(sys.argv[1]); data=json.load(sys.stdin); target=data.get("target", {}); policy=data.get("inspection", {}); claims=data.get("claims", {}); installed=data.get("os", {}); markers=installed.get("installationMarkers", {}); boot=installed.get("boot", {}); efi=boot.get("efiSystemPartition", {}); limitations=data.get("limitations", []); data.get("apiVersion") == "kernaid.dev/rescue-offline-inspection/v1alpha1" and data.get("status") == "installed-os-content-inspected" and data.get("trust") == "observed-untrusted" or sys.exit("Windows inspection envelope failed"); target.get("scanFingerprint") == request.get("scanFingerprint") and target.get("targetId") == request.get("targetId") and target.get("osFamily") == "windows" and target.get("filesystem") == "ntfs" or sys.exit("Windows inspection target binding failed"); policy.get("mode") == "temporary-read-only-no-replay" and policy.get("journalReplayPrevented") is True and policy.get("privateMountNamespace") is True and policy.get("filesystemOptions") == [] and policy.get("dirtyVolumePolicy") == "read-only-no-force-driver-replay-not-applied" and policy.get("volumeStateQualification") == "unqualified" or sys.exit("NTFS read-only no-force policy is missing"); "ntfs-dirty-and-hibernated-state-was-not-qualified" in limitations and not any(item.startswith("associated-efi-system-partition-") for item in limitations) or sys.exit("Windows GPT fixture limitations are inconsistent"); all(claims.get(key) is True for key in ("installedOsConfirmed", "filesystemContentInspected", "mountOperationAttempted", "mountOperationPerformed", "mountCleanupVerified")) and all(claims.get(key) is False for key in ("autoUnlockAttempted", "mutationPerformed", "diagnosisProduced", "repairAttempted")) or sys.exit("Windows inspection claims failed"); installed.get("family") == "windows" and installed.get("installationConfirmed") is True and all(markers.get(key) is True for key in ("windowsDirectoryPresent", "system32DirectoryPresent", "kernelPresent", "systemHivePresent", "softwareHivePresent")) or sys.exit("Windows fixture corpus was not inspected"); set(efi) == {"state", "microsoftBootManagerPresent", "bcdPresent", "fallbackBootloaderPresent"} and efi.get("state") == "inspected" and all(efi.get(key) is True for key in ("microsoftBootManagerPresent", "bcdPresent", "fallbackBootloaderPresent")) or sys.exit("same-disk EFI system partition markers were not inspected")' "$windows_selection_request" || fail "read-only Windows GPT plus ESP inspection contract failed"
        altered_windows_selection_request="$(printf '%s' "$targets" | python3 -c 'import json,sys; data=json.load(sys.stdin); disks={item.get("id"):item for item in data.get("disks", [])}; candidates=[item for item in data.get("candidates", []) if item.get("osFamilyHint") == "windows" and item.get("diskId") in disks]; partitioned=[item for item in candidates if disks[item["diskId"]].get("partitionTable") == "gpt" and item.get("sourceRef", "").startswith(disks[item["diskId"]].get("ref", "") + "/volume-")]; altered=[item for item in candidates if item.get("sourceRef") == disks[item["diskId"]].get("ref") and disks[item["diskId"]].get("partitionTable") != "gpt"]; len(candidates) == 2 and len(partitioned) == 1 and len(altered) == 1 and partitioned[0].get("targetId") != altered[0].get("targetId") or sys.exit("one GPT partition and one distinct whole-disk Windows fixture target are required"); print(json.dumps({"scanFingerprint":data["scanFingerprint"],"targetId":altered[0]["targetId"]}, separators=(",", ":")))')" || fail "ntfsfix-altered Windows target selection request failed"
        altered_windows_inspection="$(curl --fail --silent --show-error --max-time 22 -H 'Origin: http://127.0.0.1:4173' -H 'Content-Type: application/json' --data "$altered_windows_selection_request" "$base_url/api/rescue/inspect-installed-target")" || fail "read-only ntfsfix-altered Windows target inspection failed"
        printf '%s' "$altered_windows_inspection" | python3 -c 'import json,sys; request=json.loads(sys.argv[1]); data=json.load(sys.stdin); target=data.get("target", {}); policy=data.get("inspection", {}); claims=data.get("claims", {}); installed=data.get("os", {}); efi=installed.get("boot", {}).get("efiSystemPartition", {}); limitations=data.get("limitations", []); data.get("status") == "installed-os-content-inspected" and data.get("trust") == "observed-untrusted" or sys.exit("altered Windows inspection envelope failed"); target.get("scanFingerprint") == request.get("scanFingerprint") and target.get("targetId") == request.get("targetId") and target.get("osFamily") == "windows" and target.get("filesystem") == "ntfs" or sys.exit("altered Windows target binding failed"); policy.get("filesystemOptions") == [] and policy.get("dirtyVolumePolicy") == "read-only-no-force-driver-replay-not-applied" and policy.get("volumeStateQualification") == "unqualified" and policy.get("journalReplayPrevented") is True or sys.exit("altered NTFS read-only no-force policy is missing"); "ntfs-dirty-and-hibernated-state-was-not-qualified" in limitations and "associated-efi-system-partition-not-present" in limitations or sys.exit("altered NTFS limitations are incomplete"); all(claims.get(key) is True for key in ("installedOsConfirmed", "filesystemContentInspected", "mountOperationAttempted", "mountOperationPerformed", "mountCleanupVerified")) and all(claims.get(key) is False for key in ("autoUnlockAttempted", "mutationPerformed", "diagnosisProduced", "repairAttempted")) or sys.exit("altered Windows inspection claims failed"); installed.get("family") == "windows" and installed.get("installationConfirmed") is True or sys.exit("altered Windows static markers were not inspected"); set(efi) == {"state", "microsoftBootManagerPresent", "bcdPresent", "fallbackBootloaderPresent"} and efi.get("state") == "not-present" and all(efi.get(key) is None for key in ("microsoftBootManagerPresent", "bcdPresent", "fallbackBootloaderPresent")) or sys.exit("altered Windows ESP state is not conservative")' "$altered_windows_selection_request" || fail "read-only ntfsfix-altered Windows target inspection contract failed"
        echo KERNAID_RESCUE_OFFLINE_INSPECTION_READY >/dev/ttyS0
    fi
    echo KERNAID_RESCUE_TARGET_SELECTION_READY >/dev/ttyS0
fi
if [ "$offline_inspection_smoke" = "1" ] && [ -z "$selection_request" ]; then
    fail "Linux fixture target is missing"
fi
echo KERNAID_RESCUE_READY >/dev/ttyS0
