[Unit]
Description=KernAid Rescue fstab repair candidate broker
Requires=kernaid-rescue-repaird.socket kernaid-rescue-vaultd.socket kernaid-rescue-vaultd.service kernaid-rescue-target-capability.socket kernaid-rescue-target-write-capability.socket systemd-sysusers.service systemd-tmpfiles-setup.service
BindsTo=kernaid-rescue-vaultd.service
After=kernaid-rescue-repaird.socket kernaid-rescue-vaultd.socket kernaid-rescue-vaultd.service kernaid-rescue-target-capability.socket kernaid-rescue-target-write-capability.socket systemd-sysusers.service systemd-tmpfiles-setup.service
Before=kernaid-ui.service kernaid-ready.service
ConditionKernelCommandLine=boot=live
ConditionKernelCommandLine=kernaid.repair=fstab-v1
ConditionPathExists=/usr/lib/kernaid/repair-candidate-image-v1
ConditionFileIsExecutable=/usr/lib/kernaid/kernaid-rescue-repaird
ConditionFileIsExecutable=/usr/lib/kernaid/kernaid-blockfd-probe
ConditionPathIsDirectory=/run/lock/kernaid-repair

[Service]
Type=notify
NotifyAccess=main
Sockets=kernaid-rescue-repaird.socket
# Candidate-only and closed: PID 1 reads the root-only QEMU fw_cfg node. The
# fixed non-fault default makes a missing node non-fatal on ordinary boots;
# LoadCredential wins only when that exact sysfs file exists.
LoadCredential=kernaid-repair-fault:/sys/firmware/qemu_fw_cfg/by_name/opt/io.systemd.credentials/kernaid-repair-fault/raw
SetCredential=kernaid-repair-fault:none-v1
ExecStart=/usr/lib/kernaid/kernaid-rescue-repaird
# The HTTP relay verifies an unlocked Vault before it can activate this socket.
# A genuine recovery-barrier failure must return control to socket activation
# instead of entering an eager restart loop.
Restart=no
TimeoutStartSec=180s
TimeoutStopSec=45s
KillMode=control-group
SendSIGKILL=yes
StandardInput=null
StandardOutput=journal
StandardError=journal
User=kernaid-repair
Group=kernaid-repair
SupplementaryGroups=kernaid-vault
UMask=0077
LimitCORE=0
LimitNOFILE=64
TasksMax=16
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
# Target block and mount authority arrives only through the authenticated
# capability sockets; the unprivileged broker has no host /dev access.
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/run/lock/kernaid-repair
DevicePolicy=closed
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
