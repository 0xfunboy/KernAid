[Unit]
Description=KernAid Rescue Fleet local approval API socket
Requires=systemd-sysusers.service
After=systemd-sysusers.service
Before=kernaid-fleet-rescue-repair.service kernaid-ui.service
ConditionKernelCommandLine=boot=live
ConditionKernelCommandLine=kernaid.repair=fstab-v1
ConditionPathExists=/usr/lib/kernaid/repair-candidate-image-v1
ConditionPathExists=/etc/kernaid/fleet-rescue-repair.json

[Socket]
ListenSequentialPacket=/run/kernaid-fleet-rescue-repair.sock
Accept=no
Backlog=4
FlushPending=yes
FileDescriptorName=fleet-rescue-api
SocketMode=0660
SocketUser=root
SocketGroup=kernaid-repair-client
RemoveOnStop=yes
PassCredentials=no
PassSecurity=no
PassPacketInfo=no
Timestamping=off

[Install]
WantedBy=sockets.target
