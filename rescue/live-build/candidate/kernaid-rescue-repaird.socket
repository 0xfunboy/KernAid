[Unit]
Description=KernAid Rescue fstab repair candidate API socket
Requires=systemd-sysusers.service
After=systemd-sysusers.service
Before=kernaid-rescue-repaird.service kernaid-ui.service
ConditionKernelCommandLine=boot=live
ConditionKernelCommandLine=kernaid.repair=fstab-v1
ConditionPathExists=/usr/lib/kernaid/repair-candidate-image-v1

[Socket]
ListenSequentialPacket=/run/kernaid-rescue-repair.sock
Accept=no
Backlog=4
FlushPending=yes
FileDescriptorName=repair-api
SocketMode=0660
SocketUser=root
SocketGroup=kernaid-repair-client
RemoveOnStop=yes
PassCredentials=no
PassSecurity=no
PassPacketInfo=no
Timestamping=off

[Install]
WantedBy=sockets.target
