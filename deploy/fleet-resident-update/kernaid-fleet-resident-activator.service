[Unit]
Description=KernAid Fleet Resident local A/B boot activator
Documentation=https://github.com/0xfunboy/KernAid/tree/main/deploy/fleet-resident-update
After=local-fs.target
ConditionPathIsDirectory=/sys/firmware/efi
ConditionPathIsMountPoint=/sys/firmware/efi/efivars
ConditionPathExists=/etc/kernaid/fleet-resident-activator.json
ConditionPathExists=/boot/loader/entries/kernaid-slot-a.conf
ConditionPathExists=/boot/loader/entries/kernaid-slot-b.conf
StartLimitIntervalSec=300s
StartLimitBurst=4

[Service]
Type=oneshot
ExecStart=/usr/libexec/kernaid-fleet-resident-activator
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kernaid/fleet-resident-update
ReadWritePaths=/boot
ReadWritePaths=/sys/firmware/efi/efivars
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_ADMIN
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
