{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KernAid Desk",
  "version": "0.1.0",
  "identifier": "dev.kernaid.desk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title":"KernAid Desk","width":1440,"height":900,"minWidth":1024,"minHeight":700}],
    "security": {"csp":"default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
