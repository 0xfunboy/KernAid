{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KernAid Rescue",
  "version": "0.1.0",
  "identifier": "dev.kernaid.rescue",
  "build": {
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "rescue-shell-native-prompt-only",
          "description": "The exact loopback Rescue UI may request only the closed, feature-gated native Vault prompt.",
          "local": false,
          "remote": {
            "urls": ["http://127.0.0.1:4173/*"]
          },
          "windows": ["main"],
          "permissions": [
            "allow-rescue-native-prompt-status",
            "allow-open-rescue-native-prompt"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../src-tauri/icons/icon.png"]
  }
}
