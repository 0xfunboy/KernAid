{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kernaid.dev/v1/rescue-vault-request.json",
  "title": "RescueVaultRequest",
  "description": "One UTF-8 AF_UNIX SOCK_SEQPACKET request. Peer PID, UID and received descriptors are authenticated out of band.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "requestId",
    "expectedStateVersion",
    "operation",
    "payload"
  ],
  "properties": {
    "apiVersion": { "const": "kernaid.dev/rescue-vault/v1alpha1" },
    "requestId": {
      "type": "string",
      "pattern": "^R-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "expectedStateVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "operation": {
      "enum": [
        "vault.status",
        "vault.unlock",
        "vault.lock",
        "provider.openai.configure",
        "provider.status",
        "provider.logout",
        "provider.openai.borrow",
        "provider.codex.home_lease",
        "audit.append",
        "report.persist",
        "report.list",
        "report.get"
      ]
    },
    "payload": { "type": "object" }
  },
  "$defs": {
    "emptyPayload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "passphraseDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "size"],
      "properties": {
        "type": { "const": "passphrase-pipe" },
        "size": { "type": "integer", "minimum": 12, "maximum": 1024 }
      }
    },
    "openaiKeyDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "size"],
      "properties": {
        "type": { "const": "openai-api-key-pipe" },
        "size": { "type": "integer", "minimum": 1, "maximum": 512 }
      }
    },
    "sessionReportDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "size"],
      "properties": {
        "type": { "const": "session-report-json-pipe" },
        "size": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1048576
        }
      }
    },
    "errorToken": {
      "enum": [
        "ABSENT",
        "UNPROVISIONED",
        "LOCKED",
        "BAD_PASSPHRASE",
        "MEDIA_CHANGED",
        "PROFILE_MISMATCH",
        "STALE_STATE",
        "FD_REQUIRED",
        "FD_FORBIDDEN",
        "NOT_AUTHORIZED",
        "RATE_LIMITED",
        "BUSY",
        "PROVIDER_UNCONFIGURED",
        "REPORT_TOO_LARGE",
        "IO_FAILED",
        "REBOOT_REQUIRED"
      ]
    },
    "reportId": {
      "type": "string",
      "pattern": "^RP-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "vault.status",
              "vault.lock",
              "provider.status",
              "provider.openai.borrow",
              "provider.codex.home_lease",
              "report.list"
            ]
          }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/emptyPayload" } }
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "vault.unlock" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input"],
            "properties": {
              "input": { "$ref": "#/$defs/passphraseDescriptor" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": { "const": "provider.openai.configure" }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input"],
            "properties": {
              "input": { "$ref": "#/$defs/openaiKeyDescriptor" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "provider.logout" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider"],
            "properties": {
              "provider": { "enum": ["openai", "codex"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "audit.append" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "event", "outcome"],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "event": {
                "enum": [
                  "agent-session-start",
                  "agent-diagnosis-complete",
                  "agent-session-end"
                ]
              },
              "outcome": { "enum": ["succeeded", "rejected", "failed"] },
              "error": { "$ref": "#/$defs/errorToken" }
            },
            "oneOf": [
              {
                "properties": { "outcome": { "const": "succeeded" } },
                "not": {
                  "properties": { "error": {} },
                  "required": ["error"]
                }
              },
              {
                "properties": {
                  "outcome": { "enum": ["rejected", "failed"] }
                },
                "required": ["error"]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "report.persist" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reportId", "payloadSha256", "input"],
            "properties": {
              "reportId": { "$ref": "#/$defs/reportId" },
              "payloadSha256": { "$ref": "#/$defs/sha256" },
              "input": { "$ref": "#/$defs/sessionReportDescriptor" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "report.get" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reportId"],
            "properties": {
              "reportId": { "$ref": "#/$defs/reportId" }
            }
          }
        }
      }
    }
  ]
}
