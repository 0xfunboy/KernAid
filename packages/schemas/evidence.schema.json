{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kernaid.dev/v1/evidence.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "collector",
    "target",
    "capturedAt",
    "contentType",
    "sha256",
    "sensitivity",
    "trust",
    "summary",
    "blobRef"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^E-[A-Za-z0-9-]+$",
      "maxLength": 128
    },
    "collector": { "type": "string", "minLength": 1, "maxLength": 256 },
    "target": { "type": "string", "minLength": 1, "maxLength": 512 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "contentType": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sensitivity": { "enum": ["public", "system", "sensitive"] },
    "trust": { "const": "observed-untrusted" },
    "summary": { "type": "string", "maxLength": 8192 },
    "blobRef": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
